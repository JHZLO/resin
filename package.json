{
  "name": "resin",
  "private": true,
  "version": "0.0.0",
  "description": "A small language for ER diagrams that compiles to Mermaid erDiagram",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "resin": "node src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "elkjs": "0.12.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "mermaid": "11.16.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "elkjs": ">=0.9"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  }
}
