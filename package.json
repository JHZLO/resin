{
  "name": "@jhzlo/resin",
  "version": "0.2.3",
  "description": "A small language for entity-relationship diagrams, drawn as SVG.",
  "keywords": [
    "erd",
    "er-diagram",
    "entity-relationship",
    "dsl",
    "database",
    "schema",
    "svg"
  ],
  "homepage": "https://jhzlo.github.io/resin/",
  "bugs": {
    "url": "https://github.com/JHZLO/resin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JHZLO/resin.git"
  },
  "license": "MIT",
  "author": "JHZLO (https://github.com/JHZLO)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "default": "./dist/viewer/index.js"
    },
    "./viewer.css": {
      "types": "./dist/viewer/viewer.css.d.ts",
      "default": "./dist/viewer/viewer.css"
    }
  },
  "types": "./dist/src/index.d.ts",
  "bin": {
    "resin": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer && tsc --noEmit -p playground && tsc --noEmit -p website && tsc --noEmit -p tests",
    "check": "pnpm typecheck && vitest run",
    "resin": "node src/cli.ts",
    "build:site": "node scripts/build-site.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json && cp viewer/viewer.css dist/viewer/viewer.css && echo 'export {};' > dist/viewer/viewer.css.d.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.33.2",
  "peerDependencies": {
    "elkjs": ">=0.9"
  },
  "peerDependenciesMeta": {
    "elkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "elkjs": "0.12.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
