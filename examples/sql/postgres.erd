%% Skipped: 1 function, 1 materialized view, 1 trigger

external table `public.shop_items` {
  shop_id  bigint
  sku      text
}

table users {
  id          bigint        pk
  email       varchar(255)  uk as users_email_key
  tags        _text
  created_at  timestamptz
  %% Not converted: index users_lower_email on (lower((email)::text))
}

table orders "Customer orders" {
  id          bigint         pk
  user_id     bigint?        -> users  index as orders_user_id_idx  "Who placed it (may be empty)"
  status      order_status   enum(PENDING, PAID, `in progress`)
  kind        varchar(16)    enum(ONLINE, STORE)
  total       numeric(12,2)
  deleted_at  timestamp?
  %% Partial unique index orders_one_open on (user_id) WHERE (deleted_at IS NULL), drawn as a plain index
}

table order_items {
  order_id  bigint   pk  -> orders
  line      integer  pk
  shop_id   bigint?
  sku       text?
  foreign(shop_id, sku) -> `public.shop_items`(shop_id, sku) as order_items_shop_sku_fkey
}
