erDiagram
    %% solid(--)=physical FK / dotted(..)=logical reference
    users ||..o{ orders : "user_id"
    orders ||--o{ order_items : "order_id"
    orders ||..o| payments : "order_id"
    users |o..o{ payments : "payer_user_id"

    revinfo ||..o{ orders_aud : "Envers rev"
    revinfo ||..o{ payments_aud : "Envers rev"

    users["users (Accounts service)"]:::external {
        bigint id PK
    }

    orders["orders (Customer orders)"] {
        bigint id PK
        bigint user_id FK "Customer; ~> users.id (idx_user_id)"
        varchar(32) order_no UK "Order number (uk_order_no)"
        varchar? buyer_name "Buyer name (enc)"
        varchar status "PENDING/PAID/CANCELED (idx_status)"
        datetime created_at
        datetime updated_at
    }

    order_items["order_items (Order lines)"] {
        bigint id PK
        bigint order_id FK "-> orders.id (ix_order_id); uk_order_product(order_id,product_id)"
        bigint product_id "Product in the catalog service"
        int quantity
        datetime created_at
    }

    payments["payments (Payments)"] {
        bigint id PK
        bigint order_id FK,UK "One payment per order; ~> orders.id"
        bigint? payer_user_id FK "~> users.id"
        decimal(12,2) amount
        varchar method "CARD/BANK_TRANSFER"
        datetime created_at
        datetime? updated_at
    }

    revinfo {
        int rev PK
        bigint revtstmp
    }

    orders_aud {
        bigint id PK
        int rev PK,FK
        tinyint revtype
        bigint user_id
        varchar status
    }

    payments_aud {
        bigint id PK
        int rev PK,FK
        tinyint revtype
        bigint order_id
        bigint payer_user_id
        decimal(12,2) amount
        varchar method
    }

    classDef external stroke-dasharray:4 3
