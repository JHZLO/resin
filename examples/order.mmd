erDiagram
    %% solid(--)=physical FK / dotted(..)=logical reference
    users ||..o{ ts_order : "user_id"
    ts_order ||--o{ ts_order_item : "order_id"
    ts_order ||..o| ts_order_payment : "order_id"
    users |o..o{ ts_order_payment : "payer_user_id"

    revinfo ||..o{ ts_order_aud : "Envers rev"
    revinfo ||..o{ ts_order_payment_aud : "Envers rev"

    users["users (svc_accounts 회원)"]:::external {
        bigint id PK
    }

    ts_order["ts_order (주문)"] {
        bigint id PK
        bigint user_id FK "주문자; ~> users.id (idx_user_id)"
        varchar(32) order_no UK "주문번호 (uk_order_no)"
        varchar? buyer_name "주문자명 (enc)"
        varchar status "PENDING/PAID/CANCELED (idx_status)"
        datetime created_at
        datetime updated_at
    }

    ts_order_item["ts_order_item (주문 항목)"] {
        bigint id PK
        bigint order_id FK "-> ts_order.id (ix_order_id); uk_order_product(order_id,product_id)"
        bigint product_id "상품 ID (svc_catalog)"
        int quantity
        datetime created_at
    }

    ts_order_payment["ts_order_payment (결제)"] {
        bigint id PK
        bigint order_id FK,UK "결제 1:1 확장; ~> ts_order.id"
        bigint? payer_user_id FK "~> users.id"
        decimal(12,2) amount
        varchar method "CARD/BANK_TRANSFER"
        datetime created_at
        datetime? updated_at
    }

    revinfo {
        int rev PK
        bigint revtstmp
    }

    ts_order_aud {
        bigint id PK
        int rev PK,FK
        tinyint revtype
        bigint user_id
        varchar status
    }

    ts_order_payment_aud {
        bigint id PK
        int rev PK,FK
        tinyint revtype
        bigint order_id
        bigint payer_user_id
        decimal(12,2) amount
        varchar method
    }

    classDef external stroke-dasharray:4 3
